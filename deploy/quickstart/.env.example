# The variables deploy/quickstart/compose.yaml reads. A release writes the
# real .env into orkstack-quickstart.tar.gz with every image named by its tag
# and digest; this file lists them with placeholders and is never read.

# Required: the release's images.
ORKSTACK_ORK_IMAGE=ghcr.io/orkstack/ork:X.Y.Z@sha256:<digest>
ORKSTACK_ORKER_IMAGE=ghcr.io/orkstack/orker:X.Y.Z@sha256:<digest>
ORKSTACK_UI_IMAGE=ghcr.io/orkstack/ui:X.Y.Z@sha256:<digest>
ORKSTACK_ORKCTL_IMAGE=ghcr.io/orkstack/orkctl:X.Y.Z@sha256:<digest>
# Required: the first-party activity images, as the engine's catalog document.
ORKSTACK_ACTIVITY_CATALOG={activities: {shell: "ghcr.io/orkstack/activity-shell:X.Y.Z@sha256:<digest>", http: "…", file: "…", json: "…", git: "…", template: "…"}}

# Optional, with their defaults.
ORKSTACK_API_PORT=8080
ORKSTACK_UI_PORT=5173
ORKSTACK_TEMPORAL_UI_PORT=8233
ORKSTACK_DOCKER_SOCKET=/var/run/docker.sock
ORKSTACK_WORKDIR=${HOME}/.cache/orkstack-quickstart
ORKSTACK_ORKER_ID=quickstart
