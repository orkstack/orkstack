# The build context of deploy/source/Dockerfile is the repository root, and
# this file admits only what its stages copy (BuildKit reads
# <Dockerfile>.dockerignore): the Go module without its tests, the UI's
# sources and the examples.
*
!LICENSE
!go.mod
!go.sum
!cmd/
!gen/go/
!internal/
!pkg/
!examples/*.ork.yaml
!ui/
**/*_test.go
**/testdata
ui/node_modules
ui/.svelte-kit
ui/build
ui/e2e
ui/test
ui/test-results
ui/playwright-report
