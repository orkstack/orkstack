# Binaries
/bin/
/dist/
*.exe
/ork
/orker
/orkctl

# Go
*.test
*.out
/coverage/

# Node / UI
node_modules/
ui/.svelte-kit/
ui/build/
ui/dist/
.env
.env.*
!.env.example

# Local data / artifacts
# Unanchored: `ork` writes its local run archive under the process's working
# directory, which for `go test ./cmd/...` is the package directory.
.data/
/tmp/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Proof artifacts are committed intentionally; local scratch is not
/proof/scratch/

# Agent scratch (todos, research) is ignored, but project workflows are versioned.
# Note: ignore .atomic CONTENTS, not the dir itself, or negations cannot re-include.
.atomic/*
!.atomic/workflows/
!/proof/**/*.log
!/proof/**/*.out
