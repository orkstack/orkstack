          "minimum": 0,
          "type": "integer"
        },
        "require_signed_by": {
          "description": "string",
          "type": "string"
        },
        "run_retention": {
          "description": "Go duration, or `inherit`",
          "type": "string"
        },
        "telemetry": {
          "additionalProperties": false,
          "description": "mapping: `sink`, `task_logs` (`inherit`|`enabled`|`disabled`), `attributes`",
          "properties": {
            "attributes": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "sink": {
              "type": "string"
            },
            "task_logs": {
              "enum": [
                "disabled",
                "enabled",
                "inherit"
              ]
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "automation.trigger": {
      "additionalProperties": false,
      "properties": {
