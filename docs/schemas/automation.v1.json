  "definitions": {
    "automation.schedule": {
      "additionalProperties": false,
      "properties": {
        "catchup_window": {
          "description": "Go duration, ≥ 10s — absent means the cluster's default",
          "type": "string"
        },
        "cron": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "string, or list of strings — absent means none"
        },
        "description": {
          "description": "string, ≤ 256 bytes, no control characters",
          "maxLength": 256,
          "type": "string"
        },
        "end_at": {
          "description": "RFC 3339 — absent means unbounded",
          "format": "date-time",
          "type": "string"
        },
        "input": {
          "description": "a YAML mapping, converted to JSON by the strict mapping (`docs/JSON.md`) — absent means none",
          "type": "object"
        },
        "interval": {
          "description": "Go duration — absent means unset",
          "type": "string"
        },
        "jitter": {
          "description": "Go duration — absent means none",
          "type": "string"
        },
        "orkflow": {
          "description": "slug, **required**, fixed at creation",
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "overlap": {
          "description": "`skip`|`buffer-one`|`buffer-all`|`cancel-other`|`allow-all` — absent means `skip`",
          "enum": [
            "skip",
            "buffer-one",
            "buffer-all",
            "cancel-other",
            "allow-all"
          ]
        },
        "pause_on_failure": {
          "description": "boolean — absent means `false`",
          "type": "boolean"
        },
        "start_at": {
          "description": "RFC 3339 — absent means unbounded",
          "format": "date-time",
          "type": "string"
        },
        "timezone": {
          "description": "IANA name — absent means UTC",
          "type": "string"
        },
        "version": {
          "description": "string — absent means the current pointer at each fire",
          "type": "string"
        }
      },
      "required": [
        "orkflow"
      ],
      "type": "object"
    },
    "automation.settings": {
      "additionalProperties": false,
