      "additionalProperties": false,
      "properties": {
        "events": {
          "description": "list of event names — absent means every run transition",
          "items": {
            "enum": [
              "RUN_STARTED",
              "TASK_SCHEDULED",
              "TASK_STARTED",
              "TASK_AWAITING",
              "TASK_RESOLVED",
              "TASK_SUCCEEDED",
              "TASK_FAILED",
              "RUN_SUCCEEDED",
              "RUN_FAILED",
              "RUN_CANCELED"
            ]
          },
          "type": "array"
        },
        "orkflow": {
          "description": "slug — absent means every Orkflow",
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "secret_env": {
          "description": "environment-variable name — absent means a generated signing secret, disclosed once",
          "maxLength": 256,
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "type": "string"
        },
        "task": {
          "description": "slug; needs a `TASK_*` event — absent means every task",
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "url": {
          "description": "absolute `http(s)` URL, **required**",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
