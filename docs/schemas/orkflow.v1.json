  "description": "An Orkflow document (docs/DSL.md). This schema checks the document's shape: its keys, their types, the words a key takes, the required keys and the task kinds. It cannot check a `needs:` cycle or an unknown task; templates that read an undeclared input or a task outside the needs closure; the ancestry bound; the deployment's task ceiling; an image's interface beyond the builtin catalog; the strict YAML-to-JSON rules for `with:`, `inputs:` and `await.schema` (an editor parses `yes` and `'yes'` to the same string); pools, secrets and image policy. `orkctl orkflow validate` checks every one (docs/DSL.md, \"Validation rules\").",
  "properties": {
    "apiVersion": {
      "const": "orkstack/v1",
      "description": "The document format's version: exactly `orkstack/v1` (see \"The document header\")."
    },
    "description": {
      "description": "Human description.",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/definitions/orkflow.input"
      },
      "description": "Declared input parameters (see below).",
      "type": "object"
    },
    "kind": {
      "const": "Orkflow",
      "description": "Exactly `Orkflow`; an automation document says `Automation`."
    },
    "labels": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Free-form `map[string]string` for organization and filtering (see \"Labels\").",
      "type": "object"
    },
    "name": {
      "description": "Slug identifier, unique within its namespace.",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "namespace": {
      "description": "Slug scope; absent means the built-in `default`.",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "outputs": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Declared return contract: name to template (see below).",
      "propertyNames": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "type": "object"
    },
    "pins": {
      "additionalProperties": {
        "$ref": "#/definitions/orkflow.pin"
      },
      "description": "Declared task pins (see below).",
      "propertyNames": {
        "maxLength": 200,
        "pattern": "^[a-z][a-z0-9-]*$",
        "type": "string"
      },
      "type": "object"
    },
    "tasks": {
      "description": "List of task nodes forming a DAG.",
      "items": {
        "$ref": "#/definitions/orkflow.task"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "description": "Author-pinned version; defaults to the source's hash.",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "tasks"
  ],
  "title": "OrkStack Orkflow (orkstack/v1)",
  "type": "object"
}
