---
// The navy hero: what OrkStack is, the way in, and beside it a live run card:
// the render task of a real example, read from its file, and a task map of a
// run of it.
import { Code } from 'astro:components';
import Icon from '../shared/Icon.astro';
import CopyCommand from '../shared/CopyCommand.astro';
import { example } from '../../lib/example';
import { quickstartCommands } from '../../lib/quickstart';
import codeThemes from '../../styles/generated/code-themes.json';
import { templateInjection } from '../../lib/template-grammar.mjs';
import { route, REPO } from '../../../site.config.mjs';

const up = quickstartCommands.find((c) => c.startsWith('docker compose up'));
if (!up) throw new Error('README.md\'s Quickstart no longer starts the stack with docker compose up');

// A run part way through: the shape of examples/config-from-git.ork.yaml.
const ok = 'ok';
const run = 'running';
const wait = 'wait';
const pend = '';
const cached = 'cached';
const map = [
	{ name: 'resolve', cells: [ok] },
	{ name: 'clone', cells: [ok] },
	{ name: 'tmpl, services', cells: [cached, cached] },
	{ name: 'prepare', cells: [ok] },
	{ name: 'render', cells: [...Array(9).fill(ok), ...Array(3).fill(run), wait, ...Array(11).fill(pend)] },
	{ name: 'manifest', cells: [pend] },
];
// The map's text alternative says what its marks say.
const count = (cells: string[], kind: string) => cells.filter((c) => c === kind).length;
const render = map[4].cells;
const mapLabel = `Task map: resolve, clone and prepare succeeded; tmpl and services reused from the cache; render has ${render.length} items, ${count(render, ok)} succeeded, ${count(render, run)} running, ${count(render, wait)} waiting for capacity and ${count(render, pend)} not started; manifest not started.`;
// A code block that wraps never scrolls, so it needs no tab stop of its own.
const noTabStop = { pre(node: { properties: Record<string, unknown> }) {
	delete node.properties.tabindex;
} };
---

<section class="hero">
	<div class="in">
		<div>
			<h1>Durable workflows without workflow code.</h1>
			<p class="lede">
				Author Orkflows in YAML and run <b>any OCI image</b> as a durable step on a fleet of generic workers, the Orkers. Temporal keeps every run
				durable; OrkStack adds no SDK, no worker code and no database.
			</p>
			<div class="ctas">
				<a class="btn primary" href={route('docs/get-started/run-locally')}>Get started</a>
				<a class="btn shell" href={REPO}><Icon name="github" />View on GitHub</a>
			</div>
			<CopyCommand label="Run it locally" command={up} class="install" />
		</div>
		<div class="showcase">
			<div class="bar">
				<span class="plate"><span class="k">run</span><span class="v">ork-…080912</span></span>
				<b>{example.name}</b>
				<span class="plate ver"><span class="k">version</span><span class="v">{example.version}</span></span>
				<span class="st running push">Running</span>
			</div>
			<div class="split">
				<Code code={example.excerpt} lang="yaml" embeddedLangs={[templateInjection as any]} themes={codeThemes as any} defaultColor={false} class="showcase-code" transformers={[noTabStop as any]} />
				<div class="tmap" role="img" aria-label={mapLabel}>
					<b>Task map</b>
					{
						map.map((t) => (
							<div class="trow">
								<span class="tn">{t.name}</span>
								<span class="cells">
									{t.cells.map((c) => (
										<i class:list={['cell', c]} />
									))}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
