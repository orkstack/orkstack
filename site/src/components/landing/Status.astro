---
// Status and contributing: how OrkStack is proven, and where to take part.
import { route, repoUrl, REPO } from '../../../site.config.mjs';

const links = [
	{ label: 'Changelog', href: route('docs/reference/changelog') },
	{ label: 'Contributing', href: route('docs/contributing') },
	{ label: 'How OrkStack is proven', href: route('docs/concepts/proven') },
	{ label: 'Repository', href: REPO },
	{ label: 'MIT license', href: repoUrl('LICENSE') },
];
---

<section class="block status" aria-labelledby="status-title">
	<header class="block-head">
		<h2 id="status-title">Proven as it goes</h2>
		<p>
			OrkStack is not yet ready for production: its required failure and recovery scenarios are still being
			proven. No change counts as done until the full proof passed on the exact tree that lands: every gate,
			with the integration suites against a real Temporal cluster and object store.
		</p>
		<p>
			Questions and bugs go to <a href={`${REPO}/issues`}>GitHub Issues</a>. Contributions follow the
			contributing guide, and every pull request is proven before it merges.
		</p>
	</header>
	<ul class="status-links">
		{
			links.map((l) => (
				<li>
					<a href={l.href}>{l.label}</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.status-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-block: var(--rule-region) solid var(--color-ink);
	}
	.status-links li {
		flex: 1 1 12rem;
	}
	.status-links li + li {
		border-left: var(--rule-hair) solid var(--color-rule);
	}
	.status-links a {
		display: block;
		padding: calc(var(--spacing) * 4);
		color: var(--color-blue);
		font-size: var(--text-md);
		font-weight: var(--font-weight-semibold);
		text-decoration-line: underline;
		text-decoration-color: color-mix(in oklab, var(--color-blue) 40%, transparent);
		text-underline-offset: var(--underline-offset);
		transition: background-color var(--duration-fast) var(--ease-out);
	}
	.status-links a:hover {
		background-color: var(--color-hover);
		color: var(--color-blue-strong);
		text-decoration-color: currentColor;
	}
	@media (max-width: 639.98px) {
		.status-links li + li {
			border-left: 0;
			border-top: var(--rule-hair) solid var(--color-rule);
		}
	}
</style>
