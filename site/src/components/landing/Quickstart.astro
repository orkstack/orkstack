---
// The closing band: the one command that starts everything, and the way on.
import { quickstartCommands } from '../../lib/quickstart';
import { route } from '../../../site.config.mjs';

const up = quickstartCommands.find((c) => c.startsWith('docker compose up'));
---

<section class="card closer" aria-labelledby="closer-h">
	<div>
		<h2 id="closer-h">Run your first Orkflow on your machine</h2>
		<p><code>{up}</code> starts Temporal, object storage, the engine and an Orker; the first example runs from the docs.</p>
	</div>
	<div class="end">
		<a class="btn shell" href={route('docs/get-started/run-locally')}>Get started</a>
		<a class="btn shell" href={route('docs')}>Read the docs</a>
	</div>
</section>
