---
// Starlight's footer (its edit link and pagination), and the scripts a docs
// page's own content needs: the settings filter and the scrolling tables.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<script>
	import { wireSettingsFilter } from '../../lib/settings-filter';
	import { wireScrollingTables } from '../../lib/scrolling-tables';

	wireSettingsFilter(document);
	wireScrollingTables(document);
</script>
