---
// Starlight's footer (its edit link and pagination), then the site's foot and
// the settings filter's script.
import Default from '@astrojs/starlight/components/Footer.astro';
import SiteFooter from '../shared/SiteFooter.astro';
---

<Default {...Astro.props}><slot /></Default>
<SiteFooter />

<script>
	import { wireSettingsFilter } from '../../lib/settings-filter';

	wireSettingsFilter(document);
</script>
