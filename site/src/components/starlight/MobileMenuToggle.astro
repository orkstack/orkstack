---
// The narrow screens' menu button: the word, as on the landing page, opening
// Starlight's sidebar. The browser's popover keeps its state and its keys.
---

<button popovertarget="starlight__sidebar" class="btn sm sl-menu print:hidden">
	<span class="open-menu">Menu</span>
	<span class="close-menu">Close</span>
</button>
