---
// Starlight's header, drawn as the site's: the mark and the three places on
// the left; Starlight's own search and the repository on the right. Starlight
// renders its menu button beside this on narrow screens.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import Icon from '../shared/Icon.astro';
import { route, REPO } from '../../../site.config.mjs';

// Every page here is in the docs: the place a page belongs to is the current
// one. The sidebar marks the page itself.
const id = Astro.locals.starlightRoute.id;
const inExamples = id === 'docs/examples' || id.startsWith('docs/examples/');
const inReference = id.startsWith('docs/reference/');
const places = [
	{ label: 'Docs', href: route('docs'), current: !inExamples && !inReference },
	{ label: 'Examples', href: route('docs/examples'), current: inExamples },
	{ label: 'Reference', href: route('docs/reference/orkflow-keys'), current: inReference },
];
---

<div class="sl-head">
	<SiteTitle />
	<nav class="sl-places" aria-label="Site">
		{
			places.map((p) => (
				<a href={p.href} aria-current={p.current ? 'true' : undefined}>
					{p.label}
				</a>
			))
		}
	</nav>
	<div class="sl-end">
		<Search />
		<a class="btn shell sl-repo" href={REPO}><Icon name="github" />GitHub</a>
	</div>
</div>

<script>
	// A search from the landing page's header arrives as ?search=: open
	// Starlight's own search with those words, then clean the address.
	const params = new URLSearchParams(location.search);
	const words = params.get('search');
	if (words) {
		const open = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
		const start = () => {
			open?.click();
			const fill = (tries: number) => {
				const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
				if (input) {
					input.value = words;
					input.dispatchEvent(new Event('input', { bubbles: true }));
				} else if (tries > 0) setTimeout(() => fill(tries - 1), 100);
			};
			fill(50);
		};
		// Starlight enables the button once its script has run.
		if (open && !open.disabled) start();
		else if (open) new MutationObserver((_, o) => (o.disconnect(), start())).observe(open, { attributes: true, attributeFilter: ['disabled'] });
		history.replaceState(null, '', location.pathname + location.hash);
	}
</script>
