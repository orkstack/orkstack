---
// A screenshot in both themes: two pictures, one shown per theme by
// base.css (.theme-pair), each served as AVIF and WebP by Astro's image
// pipeline. After Landpack's ThemeImage (MIT, see site/THIRD_PARTY.md),
// switched on data-theme and the system preference instead of a class.
import { Picture } from 'astro:assets';
import type { Shot } from '../../lib/media';

interface Props {
	shot: Shot;
	eager?: boolean;
	sizes?: string;
	class?: string;
}
const { shot, eager = false, sizes = '(min-width: 1280px) 1200px, 100vw', class: className } = Astro.props;
const widths = [640, 960, 1280, 1600];
---

<div class:list={['theme-pair', 'shot', className]}>
	{
		shot.light ? (
			<Picture
				src={shot.light}
				alt={shot.alt}
				formats={['avif', 'webp']}
				widths={widths.filter((w) => w <= shot.light!.width)}
				sizes={sizes}
				loading={eager ? 'eager' : 'lazy'}
				fetchpriority={eager ? 'high' : undefined}
			/>
		) : (
			<div class="shot-missing" role="img" aria-label={shot.alt} />
		)
	}
	{
		shot.dark ? (
			<Picture
				src={shot.dark}
				alt={shot.alt}
				formats={['avif', 'webp']}
				widths={widths.filter((w) => w <= shot.dark!.width)}
				sizes={sizes}
				loading="lazy"
			/>
		) : (
			<div class="shot-missing" role="img" aria-label={shot.alt} />
		)
	}
</div>

<style>
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.shot-missing {
		aspect-ratio: 16 / 10;
		background-color: var(--color-paper-sunken);
	}
</style>
