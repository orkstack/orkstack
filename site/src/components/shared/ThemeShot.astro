---
// A screenshot in both themes: two images, one shown per theme by base.css
// (.theme-pair). Each is served as make site-media saved it, losslessly, at
// its own size and at twice it, and drawn at its own size or narrower: a
// screen shows it one to one, or scaled down, never re-encoded or enlarged.
// After Landpack's ThemeImage (MIT, see site/THIRD_PARTY.md), switched on
// data-theme and the system preference instead of a class. Both are lazy:
// the hidden one has no box, so a browser never fetches it, where an eager
// pair would cost every visitor the other theme's image.
import type { Shot } from '../../lib/media';

interface Props {
	shot: Shot;
	/** How wide it is drawn at each width of the page, for picking one x or two. */
	sizes?: string;
	class?: string;
}
const { shot, sizes = `(min-width: ${shot.width}px) ${shot.width}px, 100vw`, class: className } = Astro.props;
---

<div class:list={['theme-pair', 'shot', className]}>
	{
		[shot.light, shot.dark].map((t) =>
			t ? (
				<img
					src={t.src}
					srcset={t.srcset}
					sizes={sizes}
					width={shot.width}
					height={shot.height}
					alt={shot.alt}
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="shot-missing" role="img" aria-label={shot.alt} />
			),
		)
	}
</div>

<style>
	.shot :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
	}
	.shot-missing {
		aspect-ratio: 16 / 10;
		background-color: var(--color-paper-sunken);
	}
</style>
