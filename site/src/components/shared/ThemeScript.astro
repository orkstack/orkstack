---
// The site follows the system's light or dark setting: this paints it before
// the first frame, on the landing page and in the docs alike, on data-theme,
// the attribute ui/src/tokens.css switches on, and follows a change. With
// JavaScript off, the landing page carries no data-theme and tokens.css's own
// system block applies; Starlight renders its docs pages with data-theme="dark"
// on the server, so with JavaScript off the docs are dark.
---

<script is:inline>
	(() => {
		const query = matchMedia('(prefers-color-scheme: dark)');
		const paint = () => {
			document.documentElement.dataset.theme = query.matches ? 'dark' : 'light';
		};
		paint();
		query.addEventListener('change', paint);
		// Starlight's components call this to refresh their own picker; the site
		// has none.
		window.StarlightThemeProvider = { updatePickers() {} };
	})();
</script>
