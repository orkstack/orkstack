---
// One of the UI's own icons (ui/src/lib/icons.ts, read into icons.json by
// scripts/sync-docs.mjs so the site never bundles the UI's TypeScript), or one
// of the two only the site draws: 16-unit grid, 1.4 stroke, currentColor, and
// hidden from assistive technology. The control it sits in carries the name.
import ICONS from '../../styles/generated/icons.json';

const SITE_ICONS = {
	video: ['M3.25 4.25h6a1.5 1.5 0 0 1 1.5 1.5v4.5a1.5 1.5 0 0 1-1.5 1.5h-6a1.5 1.5 0 0 1-1.5-1.5v-4.5a1.5 1.5 0 0 1 1.5-1.5z', 'm10.75 7 3.5-2v6l-3.5-2'],
};
// A filled drawing, the one icon of the set with no stroke.
const GITHUB =
	'M8 .5a7.5 7.5 0 0 0-2.4 14.6c.4.1.5-.2.5-.4v-1.4c-2.1.5-2.5-1-2.5-1-.4-.9-.9-1.1-.9-1.1-.7-.5 0-.5 0-.5.8.1 1.2.8 1.2.8.7 1.2 1.8.8 2.3.6.1-.5.3-.8.5-1-1.7-.2-3.4-.8-3.4-3.7 0-.8.3-1.5.8-2-.1-.2-.3-1 .1-2 0 0 .6-.2 2.1.8a7 7 0 0 1 3.8 0c1.4-1 2.1-.8 2.1-.8.4 1 .2 1.8.1 2 .5.5.8 1.2.8 2 0 2.9-1.8 3.5-3.4 3.7.3.2.5.7.5 1.4v2.1c0 .2.1.5.5.4A7.5 7.5 0 0 0 8 .5';

type Name = keyof typeof ICONS | keyof typeof SITE_ICONS | 'github';
interface Props {
	name: Name;
	class?: string;
}
const { name, class: className } = Astro.props;
const paths: string[] = name === 'github' ? [] : ((ICONS as Record<string, string[]>)[name] ?? (SITE_ICONS as Record<string, string[]>)[name]);
---

{
	name === 'github' ? (
		<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" class={className}>
			<path fill="currentColor" d={GITHUB} />
		</svg>
	) : (
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={className}>
			{paths.map((d: string) => <path d={d} />)}
		</svg>
	)
}
