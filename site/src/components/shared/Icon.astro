---
// One of the UI's own icons (ui/src/lib/icons.ts, read into icons.json by
// scripts/sync-docs.mjs so the site never bundles the UI's TypeScript):
// authored SVG on a 16-unit grid, one 1.5 stroke, drawn in currentColor and
// hidden from assistive technology. The control it sits in carries the name.
import ICONS from '../../styles/generated/icons.json';

type Name = keyof typeof ICONS;
interface Props {
	name: Name;
	class?: string;
}
const { name, class: className } = Astro.props;
const paths = ICONS[name];
---

<svg
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class={className}
>
	{paths.map((d: string) => <path d={d} />)}
</svg>
