---
// A screenshot in both themes, one shown per theme by base.css (.theme-pair).
// Both are lazy: the hidden one has no box, so a browser never fetches it.
import { shot as readShot } from '../../lib/media';

interface Props {
	name: string;
	/** How wide it is drawn at each width of the page, for picking one x or two. */
	sizes: string;
}
const { name, sizes } = Astro.props;
const s = readShot(name);
---

<figure class="shot">
	<div class="theme-pair">
		{
			[s.light, s.dark].map((t) =>
				t ? <img src={t.src} srcset={t.srcset} sizes={t.srcset ? sizes : undefined} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async" /> : <div class="shot-missing" role="img" aria-label={s.alt} />,
			)
		}
	</div>
	<figcaption>{s.caption}</figcaption>
</figure>
