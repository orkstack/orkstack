---
// The landing page's frame: head and metadata, the navy header, the page, and
// the foot. Static HTML and CSS; the only scripts are the pre-paint theme
// script, the header's Menu, the copy button and the one tooltip.
import '../styles/site.css';
import '../styles/landing.css';
import ThemeScript from '../components/shared/ThemeScript.astro';
import Mark from '../components/shared/Mark.astro';
import Icon from '../components/shared/Icon.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import Tooltip from '../components/shared/Tooltip.astro';
import { SITE, REPO, route } from '../../site.config.mjs';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE);
const shareImage = new URL(`${import.meta.env.BASE_URL}og.png`, SITE);
// What the page is, for search engines: only what the page itself says.
const structured = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	name: 'OrkStack',
	description,
	url: canonical,
	codeRepository: REPO,
	license: 'https://opensource.org/license/mit',
};
const links = [
	{ href: route('docs'), label: 'Docs' },
	{ href: route('docs/examples'), label: 'Examples' },
	{ href: route('docs/reference/orkflow-keys'), label: 'Reference' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="OrkStack" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="OrkStack: durable workflows without workflow code." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={shareImage} />
		<script type="application/ld+json" set:html={JSON.stringify(structured)} />
		<ThemeScript />
	</head>
	<body class="landing">
		<a class="skip-link btn" href="#main">Skip to content</a>
		<header class="site-head on-hero" data-site-head>
			<div class="in">
				<a class="brand" href={route()}><Mark variant="navy" />OrkStack</a>
				<nav aria-label="Site" id="site-nav">
					{links.map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
				<div class="end">
					<form class="search" action={route('docs')} method="get" role="search">
						<Icon name="search" />
						<input type="search" name="search" placeholder="Search the docs" aria-label="Search the docs" />
					</form>
					<a class="btn shell" href={REPO}><Icon name="github" />GitHub</a>
					<button class="btn sm shell site-menu" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
				</div>
			</div>
		</header>
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<SiteFooter />
		<Tooltip />
		<script>
			const head = document.querySelector('[data-site-head]');
			const menu = head?.querySelector<HTMLButtonElement>('.site-menu');
			const set = (open: boolean) => {
				head?.classList.toggle('open', open);
				menu?.setAttribute('aria-expanded', String(open));
			};
			menu?.addEventListener('click', () => {
				const open = !head?.classList.contains('open');
				set(open);
				// The links open under the header: focus goes to them, not past them.
				if (open) head?.querySelector<HTMLElement>('nav a')?.focus();
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && head?.classList.contains('open')) {
					set(false);
					menu?.focus();
				}
			});
		</script>
	</body>
</html>
