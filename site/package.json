{
	"name": "orkstack-site",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"sync": "node scripts/sync-docs.mjs",
		"drift": "node scripts/check-tokens.mjs",
		"diagrams": "node scripts/readme-diagrams.mjs",
		"dev": "node scripts/sync-docs.mjs && astro dev",
		"check": "node --test 'test/**/*.test.mjs' && node scripts/sync-docs.mjs && node scripts/check-tokens.mjs && astro check",
		"build": "node scripts/sync-docs.mjs && astro build && node scripts/check-links.mjs",
		"preview": "astro preview",
		"test": "node --test 'test/**/*.test.mjs'"
	},
	"dependencies": {
		"@astrojs/starlight": "0.42.7",
		"@fontsource-variable/archivo-narrow": "5.3.0",
		"@fontsource-variable/spline-sans-mono": "5.3.0",
		"astro": "7.4.3",
		"github-slugger": "2.0.0",
		"sharp": "0.35.5",
		"starlight-links-validator": "0.27.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@playwright/test": "1.64.1",
		"typescript": "7.0.2"
	}
}
